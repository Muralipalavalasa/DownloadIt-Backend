APP_ENV=development
FRONTEND_URL=http://localhost:5173
POSTGRES_DB=downloadit
POSTGRES_USER=downloadit
POSTGRES_PASSWORD=replace-with-a-random-local-password
DATABASE_URL=postgresql+psycopg://downloadit:replace-with-a-random-local-password@localhost:5432/downloadit
JWT_SECRET_KEY=replace-with-a-random-32-byte-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOWNLOAD_ALLOWED_HOSTS=samplelib.com
DOWNLOAD_FILE_EXPIRATION_MINUTES=30
DOWNLOAD_MAX_BYTES=52428800
YTDLP_ENABLED=false
